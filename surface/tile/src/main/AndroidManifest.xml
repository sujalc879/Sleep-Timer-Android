        <activity android:name=".TileStartActivity" android:exported="false" android:theme="@style/Theme.SleepTimer.TileStart" />
        <service android:name=".SleepTimerTile" android:exported="true" android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_moon" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
